# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Model for the chat. claude-opus-5 = best quality (default);
# claude-sonnet-5 = cheaper, near-Opus for this workload.
CLAUDE_MODEL=claude-opus-5
# Bind to all interfaces so phones on the lab LAN can reach the QR upload page.
HOST=0.0.0.0
PORT=8137
DATA_DIR=./data
# Default printer shown in the new-print form (add more in the UI).
DEFAULT_PRINTER=Hyrel
# Repetrel's project folder: the app lists gcode from here and writes AI
# revisions back next to the original (as <name>_revNN.gcode).
# Defaults to C:\RepetrelProjects on Windows; leave empty to disable.
#GCODE_DIR=C:\RepetrelProjects
